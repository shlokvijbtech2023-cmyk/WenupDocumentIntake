# Choose "mock" (default, no API key needed), "groq", "openai", or "gemini"
LLM_PROVIDER=groq

# Only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# When a real LLM provider is active, every call automatically
# falls back to the deterministic mock for that turn if the live
# provider errors (bad key, rate limit, network/outage).
