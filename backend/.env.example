# Choose "mock" (default, no API key needed), "openai", or "gemini"
LLM_PROVIDER=mock

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# When LLM_PROVIDER is "openai" or "gemini", every call automatically
# falls back to the deterministic mock for that turn if the live
# provider errors (bad key, rate limit, network/outage) -- no separate
# flag needed, this is always on for a real provider.
